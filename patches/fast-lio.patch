+// The owned odometry bridge preserves camera_init coordinates in the odom frame.
+std::vector<Eigen::Vector4f> rejected_surfaces;
+double rejected_surface_stamp = -1.0;
+
+bool on_rejected_surface(const PointType &point)
+{
+    const double dt = lidar_end_time - rejected_surface_stamp;
+    if (dt < 0.0 || dt > 0.5) return false;
+    const double radius = 2.0 * filter_size_map_min;
+    for (const auto &surface : rejected_surfaces)
+    {
+        const double dx = point.x - surface[0] - dt * surface[2];
+        const double dy = point.y - surface[1] - dt * surface[3];
+        if (dx * dx + dy * dy <= radius * radius) return true;
+    }
+    return false;
+}
+
+std::vector<BoxPointType> rejected_surface_boxes()
+{
+    std::vector<BoxPointType> boxes;
+    const double dt = lidar_end_time - rejected_surface_stamp;
+    if (dt < 0.0 || dt > 0.5) return boxes;
+    const double radius = 2.0 * filter_size_map_min;
+    for (const auto &surface : rejected_surfaces)
+    {
+        BoxPointType box;
+        for (int axis = 0; axis < 2; ++axis)
+        {
+            const double previous = surface[axis] - 0.5 * surface[axis + 2];
+            const double current = surface[axis] + dt * surface[axis + 2];
+            box.vertex_min[axis] = std::min(previous, current) - radius;
+            box.vertex_max[axis] = std::max(previous, current) + radius;
+        }
+        box.vertex_min[2] = -cube_len;
+        box.vertex_max[2] = cube_len;
+        boxes.push_back(box);
+    }
+    return boxes;
+}
+
+void rejected_surface_cbk(const sensor_msgs::msg::PointCloud2::SharedPtr message)
+{
+    if (message->header.frame_id != "odom") return;
+    if (message->data.empty())
+    {
+        rejected_surfaces.clear();
+        return;
+    }
+    try
+    {
+        sensor_msgs::PointCloud2ConstIterator<float> x(*message, "x"), y(*message, "y"),
+            vx(*message, "vx"), vy(*message, "vy");
+        std::vector<Eigen::Vector4f> surfaces;
+        for (; x != x.end(); ++x, ++y, ++vx, ++vy)
+            if (std::isfinite(*x) && std::isfinite(*y) && std::isfinite(*vx) && std::isfinite(*vy))
+                surfaces.emplace_back(*x, *y, *vx, *vy);
+        rejected_surfaces = std::move(surfaces);
+        rejected_surface_stamp = rclcpp::Time(message->header.stamp).seconds();
+    }
+    catch (const std::runtime_error &)
+    {
+        rejected_surfaces.clear();
+    }
+}
